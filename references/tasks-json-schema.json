{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-skill:implementation-task-planner:tasks-json-schema:1.0.0",
  "title": "Implementation Task Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "readiness",
    "source_artifacts",
    "tasks",
    "dependencies",
    "parallel_groups",
    "validation_commands",
    "skill_routes",
    "open_questions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "feature", "feature_slug"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "feature": { "type": "string", "minLength": 1 },
        "feature_slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "enum": ["ready", "partial", "blocked"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path_or_url", "type", "role"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path_or_url": { "type": "string", "minLength": 1 },
          "type": {
            "enum": [
              "product_spec",
              "acceptance_criteria",
              "architecture_plan",
              "adr",
              "api_contract",
              "data_model",
              "constitution",
              "repository_context",
              "other"
            ]
          },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/task" }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "depends_on", "reason"],
        "properties": {
          "task_id": { "$ref": "#/$defs/task_id" },
          "depends_on": {
            "type": "array",
            "items": { "$ref": "#/$defs/task_id" },
            "uniqueItems": true
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "parallel_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "task_ids", "rationale"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "task_ids": {
            "type": "array",
            "minItems": 2,
            "items": { "$ref": "#/$defs/task_id" },
            "uniqueItems": true
          },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "validation_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "proves"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "proves": { "type": "string", "minLength": 1 }
        }
      }
    },
    "skill_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "skill", "reason"],
        "properties": {
          "task_id": { "$ref": "#/$defs/task_id" },
          "skill": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "blocks"],
        "properties": {
          "question": { "type": "string", "minLength": 1 },
          "blocks": {
            "oneOf": [
              { "const": "none" },
              {
                "type": "array",
                "items": { "$ref": "#/$defs/task_id" },
                "uniqueItems": true
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "task_id": {
      "type": "string",
      "pattern": "^T[0-9]{3}$"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "phase",
        "parallel",
        "traceability",
        "files",
        "depends_on",
        "validates",
        "validation_command",
        "skill_route"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/task_id" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["todo", "blocked", "done"] },
        "phase": { "type": "string", "minLength": 1 },
        "parallel": { "type": "boolean" },
        "traceability": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "depends_on": {
          "type": "array",
          "items": { "$ref": "#/$defs/task_id" },
          "uniqueItems": true
        },
        "validates": { "type": "string", "minLength": 1 },
        "validation_command": { "type": "string", "minLength": 1 },
        "skill_route": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    }
  }
}
